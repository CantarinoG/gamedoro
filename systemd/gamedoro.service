[Unit]
Description=gamedoro - gamified pomodoro for Steam games

[Service]
# The two paths below are filled in by install.sh.
WorkingDirectory=@REPO@
ExecStart=@PYTHON@ -m gamedoro
Environment=PYTHONUNBUFFERED=1
# Restart if it crashes, but not after a config error (exit status 2): that
# needs fixing, and would otherwise restart in a loop. See: journalctl --user -u gamedoro
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=3
# On stop, systemd sends SIGTERM and the daemon thaws games before exiting.
TimeoutStopSec=10

[Install]
WantedBy=default.target
